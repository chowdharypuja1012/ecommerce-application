# Gateway environment variables
# Copy this file to .env and fill in the values — never commit .env

DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# CORS — frontend dev server origin
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Upstream service base URLs
ACCOUNTS_SERVICE_URL=http://127.0.0.1:8001
CATALOGUE_SERVICE_URL=http://127.0.0.1:8002
CART_SERVICE_URL=http://127.0.0.1:8003
WISHLIST_SERVICE_URL=http://127.0.0.1:8004
ORDERS_SERVICE_URL=http://127.0.0.1:8005
PAYMENTS_SERVICE_URL=http://127.0.0.1:8006
REVIEWS_SERVICE_URL=http://127.0.0.1:8007
